# Copy to .env and fill in your own values. Never commit .env.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed to call this API, comma separated. The first one is used in invite links.
FRONTEND_URL=http://localhost:3000

RESEND_API_KEY=
MAIL_FROM="Baptist Academy <noreply@example.com>"
TERMII_API_KEY=
TERMII_SENDER_ID=

PORT=4000
