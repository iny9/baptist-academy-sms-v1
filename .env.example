# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Real keys belong in your hosting dashboard (Vercel or Netlify).

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. This key bypasses Row Level Security, so it must never start with NEXT_PUBLIC_
# and must never be pasted into client code, chat, screenshots or issues.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Address the site is served from (used in links inside emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign-in alias domain. People who log in with a username get an internal address of the form
# username@<this domain>. Nothing is ever sent there, but use a domain you own.
NEXT_PUBLIC_LOGIN_DOMAIN=login.example.com

# Email through Resend (optional; email features say so when unset)
RESEND_API_KEY=
MAIL_FROM="Baptist Academy <noreply@example.com>"

# SMS through Termii (optional)
TERMII_API_KEY=
TERMII_SENDER_ID=
